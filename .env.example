HENRIK_API_KEY=

# AI coach — both providers are free and reset daily. Neither is required to boot;
# without them the coach falls back to the local stat-based answers.
#
# 1) Cloudflare Workers AI (primary) needs NO key — it is a binding, not an env var:
#    Pages project → Settings → Bindings → Add → Workers AI → variable name `AI`.
#    Free grant: 10,000 Neurons/day, resets 00:00 UTC.
# 2) Gemini (fallback, used once the Workers AI grant is spent) — free key from
#    https://aistudio.google.com. RPD resets midnight Pacific.
GEMINI_API_KEY=

# Optional model overrides for the two providers above.
CF_AI_MODEL=
GEMINI_MODEL=

# /admin ads panel — set these in Cloudflare Pages → Settings → Environment variables.
# Also bind a KV namespace named FRAGLY_ADS (Settings → Functions → KV namespace bindings).
ADMIN_PASSWORD=
SESSION_SECRET=
